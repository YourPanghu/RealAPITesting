# ============================================================
# API Key 配置文件
# ============================================================
# 使用方法：
# 1. 复制此文件为 .env：  cp .env.example .env
# 2. 填入你注册获得的真实 API Key
# 3. .env 不会被提交到 Git（已在 .gitignore 中）
# ============================================================

# 和风天气 API Key
# 注册地址：https://devapi.qweather.com/
QWEATHER_API_KEY=your_qweather_key_here

# 聚合数据 API Key
# 注册地址：https://www.juhe.cn/
JUHE_API_KEY=your_juhe_key_here
