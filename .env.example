# ============================================================
# API Key 配置文件
# ============================================================
# 使用方法：
# 1. 复制此文件为 .env：  cp .env.example .env
# 2. 填入你注册获得的真实 API Key
# 3. .env 不会被提交到 Git（已在 .gitignore 中）
# ============================================================

# 和风天气 API Key
# 注册地址：https://dev.qweather.com/docs/api/
QWEATHER_API_KEY=7b57dbc17c524f3a98819ac9353033f3
# your_qweather_key_here

# 聚合数据 API Key
# 注册地址：https://www.juhe.cn/
# 支持多个 Key（用英文逗号分隔），用于不同接口订阅了不同 Key 的场景
# 例如：JUHE_API_KEY=新闻的key,笑话的key
JUHE_API_KEY=6b0d33f0b8aab0e34b68351cbb65c8b1
# your_juhe_key_here